# Application environment: development, testing, or production
FLASK_ENV=development
FLASK_DEBUG=True

# Secret key for session security (change to a random string in production)
SECRET_KEY=rbs_dev_secret_key_change_in_production_2026_q11

# SQLite Database path (relative to instance directory or absolute path)
DATABASE_PATH=instance/restaurant.db

# Diagnostic Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=5

# Server Port
PORT=5000
HOST=127.0.0.1
