# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Environments
venv/
env/
ENV/
.env

# Instance and SQLite database files (keep directory, ignore actual db)
instance/*.db
instance/*.sqlite
instance/*.sqlite3
!instance/.gitkeep

# Application logs (keep directory, ignore actual logs)
logs/*.log
!logs/.gitkeep

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
